# Generate APP_PASSWORD_HASH using npm run setup:auth. Never put the password in React.
APP_PASSWORD_HASH=
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5000
# Set NODE_ENV=production behind HTTPS to require secure session cookies.
# Replace all previously exposed bot tokens before enabling these integrations.
TELEGRAM_BILL_TOKEN=
TELEGRAM_BILL_CHAT_ID=
TELEGRAM_ONSITE_TOKEN=
TELEGRAM_ONSITE_CHAT_ID=
IDRIVERPLUS_USERNAME=
IDRIVERPLUS_PASSWORD=
# Robot reports: 08:00 current status; 00:00 previous day's area (Asia/Bangkok).
TELEGRAM_ROBOT_ENABLED=false
TELEGRAM_ROBOT_TOKEN=
TELEGRAM_ROBOT_CHAT_ID=
